server.port=8081
spring.application.name=SmartProp

# Database connection settings
spring.datasource.url=jdbc:mysql://localhost:3306/smartprop_db?createDatabaseIfNotExist=true
spring.datasource.username=root
# אל תשימי פה את הסיסמה האמיתית שלך!
spring.datasource.password=YOUR_PASSWORD_HERE 

# Hibernate settings
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect

# Google Cloud API Key
# אל תשימי פה את המפתח האמיתי!
google.api.key=YOUR_GOOGLE_API_KEY_HERE